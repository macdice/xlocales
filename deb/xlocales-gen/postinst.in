#!/bin/sh

set -e

case "$1" in
    configure)
        src_dir="@prefix@/share/i18n.@origin@"
        dst_dir="@prefix@/lib/locale.@origin@"
        dst_mod_dir="@prefix@/lib/locale@@origin@"

        mkdir -p "$dst_dir"
        mkdir -p "$dst_mod_dir"

        echo "Compiling locales in $dst_dir"
        if [ -x /usr/bin/xargs ] ; then
            while read -r locale locale_src charmap modifiers ; do
                echo "printf '\r%-79s' 'Compiling $dst_dir/$locale' ; I18NPATH=$src_dir localedef -f $charmap -i $locale_src $dst_dir/$locale"
            done < "$src_dir/xlocales.supported" | \
            /usr/bin/xargs -P $(nproc) -I {} sh -c '{}'
        else
            while read -r locale locale_src charmap modifiers ; do
                printf '\r%-79s' "Compiling $dst_dir/$locale"
                I18NPATH=$src_dir localedef -f $charmap -i $locale_src $dst_dir/$locale
            done < "$src_dir/xlocales.supported"
        fi
        printf '\r%-79s\r' ''

        echo "Installing locales with modifiers in $dst_mod_dir"
        while read -r locale locale_src charmap modifiers ; do
            for mod in $modifiers ; do
                if [ ! -L "$dst_mod_dir/$locale@$mod" ] ; then
                    ln -s "../locale.@origin@/$locale" "$dst_mod_dir/$locale@$mod"
                fi
            done
        done < "$src_dir/xlocales.supported"
        ;;
esac

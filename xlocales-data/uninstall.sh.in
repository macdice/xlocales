#!/bin/sh
#
# Remove compiled locales from $origin.

set -e

system_locale_path="$DESTDIR@system_locale_path@"
mod_path="$DESTDIR@prefix@/lib/locale@@origin@"

for locale in $(ls "$mod_path") ; do
    if [ -L "$system_locale_path/$locale" ] ; then
        target_path="$(readlink "$system_locale_path/$locale")"
        echo "$locale -> $target_path"
        if [ "$target_path" = "@prefix@/lib/locale@@origin@/$locale" ] ; then
            echo "Can't remove $mod_path/$locale because $system_locale_path/$locale references it.  Consider select.sh -d $(echo "$locale" | sed 's/[^@]*//') to delete it." >&2
            exit 1
        fi
    fi
done

echo rm -fr "$DESTDIR@prefix@/lib/locales@@origin@"
echo rm -fr "$DESTDIR@prefix@/lib/locales.@origin@"

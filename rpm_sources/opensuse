XLOCALES_SOURCE="opensuse"
XLOCALES_RPM_REPO_URL1="https://ftp.gwdg.de/pub/opensuse/discontinued/source/distribution/leap/@VERSION@/repo/oss"
XLOCALES_RPM_REPO_URL2="https://download.opensuse.org/source/distribution/leap/@VERSION@/repo/oss"
XLOCALES_RPM_REPO_DIR_URL1="https://ftp.gwdg.de/pub/opensuse/discontinued/source/distribution/leap/"
XLOCALES_RPM_REPO_DIR_URL2="https://download.opensuse.org/source/distribution/leap/"
XLOCALES_RPM_REPO_DIR_REGEX='>\([0-9][0-9]*\.[0-9]*\)/<'
XLOCALES_RPM_REPO_DIR_FIND_HIGHEST_MINOR="1"
XLOCALES_RPM_PACKAGE="glibc"

# Fix some inconsistencies in references to suse_version macro, so that it
# always defaults to 0 on non-OpenSUSE machines instead of failing.
XLOCALES_RPM_SPEC_SED='s| 0\?%{\?suse_version}\?| 0%{?suse_version}|'

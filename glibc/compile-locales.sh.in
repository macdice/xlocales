#!/bin/sh
#
# Compile the locale data from @prefix@/share/i18n.@origin@.
# Compiles in parallel if GNU xargs is available.

set -e

src_dir="$DESTDIR@prefix@/share/i18n@@origin@"
dst_dir="$DESTDIR@prefix@/lib/locale.@origin@"
dst_mod_dir="$DESTDIR@prefix@/lib/locale@@origin@"

mkdir -p "$dst_dir"
mkdir -p "$dst_mod_dir"

# Locales:  @prefix@/lib/locale.@origin@/LOCALE
if which xargs > /dev/null ; then
    while read -r locale locale_src charmap ; do
        echo "echo \"$dst_dir/$locale\" ; I18NPATH=$src_dir localedef -f $charmap -i $locale_src $dst_dir/$locale"
    done < "$src_dir/xlocales.supported" | xargs -P$(nproc) -I {} sh -c '{}'
else
    while read -r locale locale_src charmap ; do
        echo "$dst_dir/$locale"
        I18NPATH=$src_dir localedef -f $charmap -i $locale_src $dst_dir/$locale
    done < "$src_dir/xlocales.supported"
fi

# Symlinks: @prefix@/lib/locale@@origin@/LOCALE@@origin@
#           @prefix@/lib/locale@@origin@/LOCALE@glibc@libc_version@
#           @prefix@/lib/locale@@origin@/LOCALE@unicode@unicode_version@
while read -r locale locale_src charmap ; do
    for mod in "@origin@" \
               "glibc@libc_version@" \
               "unicode@@unicode_version@" ; do
        if [ ! -L "$dst_mod_dir/$locale@$mod" ] ; then
            ln -s "../locale.@origin@/$locale" "$dst_mod_dir/$locale@$mod"
        fi
    done
done < "$src_dir/xlocales.supported"
